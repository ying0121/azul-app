{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Daily Team Huddle",
  "version": "0.1.0",
  "identifier": "com.dailyhuddle.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Daily Team Huddle",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "visible": true,
        "dragDropEnabled": false,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Daily Team Huddle",
    "copyright": "Copyright (C) 2026 Daily Team Huddle",
    "shortDescription": "Daily Team Huddle desktop collaboration application",
    "longDescription": "Daily Team Huddle is a desktop collaboration application for team meetings, remote support, and workflow management.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "C:\\Program Files (x86)\\Windows Kits\\10\\bin\\10.0.26100.0\\x64\\signtool.exe",
        "args": [
          "sign",
          "/a",
          "/fd",
          "SHA256",
          "/tr",
          "http://timestamp.digicert.com",
          "/td",
          "SHA256",
          "%1"
        ]
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
